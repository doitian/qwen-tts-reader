# Required: replace YOUR_WORKSPACE with your Beijing Model Studio workspace ID.
# Native streaming WebSocket endpoint, including the API path.
QWEN_TTS_ENDPOINT=wss://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# Required: the API key for the configured endpoint.
QWEN_TTS_API_KEY=
# Also selectable with --model or the Model button in the TUI.
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# Leave blank to use the selected model's matching default voice.
QWEN_TTS_VOICE=
# Optional key for additional Defuddle requests:
# DEFUDDLE_API_KEY=
